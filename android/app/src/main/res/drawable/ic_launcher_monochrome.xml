<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed icons on Android 13+ take only this layer's alpha and apply the system's own tint, so it is
  the Smile ID mark alone: the badge plate is white-on-white and the green glyph carries no meaning
  once tinted, and both read as noise at launcher size. Scaled into the same safe box as the
  foreground, but on its own bounds, so the mark sits centred rather than offset the way the badge
  pulls it in the colour icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <group
        android:pivotX="250"
        android:pivotY="240"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:translateX="6"
        android:translateY="16">
        <group
            android:scaleX="0.7"
            android:scaleY="0.7"
            android:translateX="52.6"
            android:translateY="42.635">
            <path
                android:fillColor="#000000"
                android:pathData="M 81.1 279.4 h 232.1 v 216.9 h -232.1 z" />
