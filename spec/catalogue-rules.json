  "captureAs": {
    "rule": "How the form's 'Capture as' becomes DocumentCaptureConfig.documentType. The default is matchDocument (no override): it keys on the row's code and sub-type and never reads format, so sub-type green_book is the Green Book preset, code PASSPORT the Passport preset, and anything else a GenericDocument whose hasBackSide is the row's has_back, with the SDK's defaults for the rest. The three presets are overrides that apply whatever the document; genericDocument builds from the generic-document sheet. The server always receives the row's code as idType. captureBothSides is the Settings switch, except false for a resolved Passport, and the SDK ANDs it with the type's hasBackSide. The trigger names the result: a matched preset reads '<preset> · matches document', a matched GenericDocument 'Generic document · <orientation> · <sides>', a chosen preset '<preset> · chosen', and a chosen GenericDocument '<displayName> · <orientation> · <sides> · chosen', where <sides> is 'front and back' when both captureBothSides and hasBackSide are true and 'front only' otherwise. The sheet's first row reads 'Match document (<preset or Generic document>)'.",
    "triggerPlaceholder": "Match document",
    "cases": [
      {
        "name": "Match: a two-sided identity card is a GenericDocument with a back",
        "captureAs": "matchDocument",
        "document": {
          "code": "IDENTITY_CARD",
          "name": "Identity Card",
          "hasBack": true,
          "format": 1
        },
        "expected": {
          "documentType": "generic",
          "displayName": "Document",
          "hasBackSide": true,
          "orientation": "landscape",
          "idType": "IDENTITY_CARD",
          "matched": true,
          "captureBothSides": true,
          "triggerText": "Generic document · landscape · front and back",
          "matchRowLabel": "Match document (Generic document)"
        }
      },
      {
        "name": "Match: a one-sided card (KE ALIEN_CARD) is a GenericDocument without a back",
        "captureAs": "matchDocument",
        "document": {
          "code": "ALIEN_CARD",
          "name": "Alien ID",
          "hasBack": false,
          "format": 1
        },
        "expected": {
          "documentType": "generic",
          "displayName": "Document",
          "hasBackSide": false,
          "orientation": "landscape",
          "idType": "ALIEN_CARD",
          "matched": true,
          "captureBothSides": true,
          "triggerText": "Generic document · landscape · front only",
          "matchRowLabel": "Match document (Generic document)"
        }
      },
      {
        "name": "Match: a passport is the Passport preset, captured front only",
        "captureAs": "matchDocument",
        "document": {
          "code": "PASSPORT",
          "name": "Passport",
          "hasBack": false,
          "format": 3
        },
        "expected": {
          "documentType": "passport",
          "idType": "PASSPORT",
          "matched": true,
          "captureBothSides": false,
          "triggerText": "Passport preset · matches document",
          "matchRowLabel": "Match document (Passport preset)"
        }
      },
      {
        "name": "Match: the Green Book is the Green Book preset on Document Verification, submitting the parent code",
        "captureAs": "matchDocument",
        "document": {
          "code": "IDENTITY_CARD",
          "subType": "green_book",
          "name": "Green Book",
          "hasBack": false,
          "format": 7
        },
        "expected": {
          "documentType": "greenBook",
          "idType": "IDENTITY_CARD",
          "matched": true,
          "captureBothSides": true,
          "triggerText": "Green Book preset · matches document",
          "matchRowLabel": "Match document (Green Book preset)"
        }
      },
      {
        "name": "Match: a seaman's book is a GenericDocument, because format is never read",
        "captureAs": "matchDocument",
        "document": {
          "code": "SEAMANS_ID",
          "name": "Seaman's ID",
          "hasBack": true,
          "format": 3
        },
        "expected": {
          "documentType": "generic",
          "displayName": "Document",
          "hasBackSide": true,
          "orientation": "landscape",
          "idType": "SEAMANS_ID",
          "matched": true,
          "captureBothSides": true,
          "triggerText": "Generic document · landscape · front and back",
          "matchRowLabel": "Match document (Generic document)"
        }
      },
      {
        "name": "Match: an unknown sub-type is a GenericDocument that takes its row's has_back",
        "captureAs": "matchDocument",
        "document": {
          "code": "IDENTITY_CARD",
          "subType": "future_card",
          "name": "Future Card",
          "hasBack": false,
          "format": 1
        },
        "expected": {
          "documentType": "generic",
          "displayName": "Document",
          "hasBackSide": false,
          "orientation": "landscape",
          "idType": "IDENTITY_CARD",
          "matched": true,
          "captureBothSides": true,
          "triggerText": "Generic document · landscape · front only",
          "matchRowLabel": "Match document (Generic document)"
        }
      },
      {
        "name": "Match: the Settings switch off makes a two-sided card front only",
        "captureAs": "matchDocument",
        "captureBothSides": false,
        "document": {
          "code": "IDENTITY_CARD",
          "name": "Identity Card",
          "hasBack": true,
          "format": 1
        },
        "expected": {
          "documentType": "generic",
          "displayName": "Document",
          "hasBackSide": true,
          "orientation": "landscape",
          "idType": "IDENTITY_CARD",
          "matched": true,
          "captureBothSides": false,
          "triggerText": "Generic document · landscape · front only",
          "matchRowLabel": "Match document (Generic document)"
        }
      },
      {
        "name": "Passport preset, whatever the document, captured front only",
        "captureAs": "passport",
        "document": {
          "code": "IDENTITY_CARD",
          "name": "Identity Card",
          "hasBack": true,
          "format": 1
        },
        "expected": {
          "documentType": "passport",
          "idType": "IDENTITY_CARD",
          "matched": false,
          "captureBothSides": false,
          "triggerText": "Passport preset · chosen",
          "matchRowLabel": "Match document (Generic document)"
        }
      },
      {
        "name": "Green Book preset, whatever the document",
        "captureAs": "greenBook",
        "document": {
          "code": "PASSPORT",
          "name": "Passport",
          "hasBack": false,
          "format": 3
        },
        "expected": {
          "documentType": "greenBook",
          "idType": "PASSPORT",
          "matched": false,
          "captureBothSides": true,
          "triggerText": "Green Book preset · chosen",
          "matchRowLabel": "Match document (Passport preset)"
        }
      },
      {
        "name": "Generic document on a passport row stays generic, and captures two sides",
        "captureAs": "genericDocument",
        "document": {
          "code": "PASSPORT",
          "name": "Passport",
          "hasBack": false,
          "format": 3
        },
        "expected": {
          "documentType": "generic",
          "displayName": "Document",
          "hasBackSide": true,
          "orientation": "landscape",
          "idType": "PASSPORT",
          "matched": false,
          "captureBothSides": true,
          "triggerText": "Document · landscape · front and back · chosen",
          "matchRowLabel": "Match document (Passport preset)"
        }
      },
      {
        "name": "Generic document builds a GenericDocument from the sheet",
        "captureAs": "genericDocument",
        "document": {
          "code": "PASSPORT",
          "name": "Passport",
          "hasBack": false,
          "format": 3
        },
        "genericDocument": {
          "displayName": "Booklet",
          "hasBackSide": true,
          "orientation": "portrait",
          "aspectRatio": "booklet"
        },
        "expected": {
          "documentType": "generic",
          "displayName": "Booklet",
          "hasBackSide": true,
          "orientation": "portrait",
          "knownAspectRatio": 0.748,
          "idType": "PASSPORT",
          "matched": false,
          "captureBothSides": true,
          "triggerText": "Booklet · portrait · front and back · chosen",
          "matchRowLabel": "Match document (Passport preset)"
        }
      },
      {
        "name": "A one-sided Generic document from the sheet is front only",
        "captureAs": "genericDocument",
        "document": {
          "code": "IDENTITY_CARD",
          "name": "Identity Card",
          "hasBack": true,
          "format": 1
        },
        "genericDocument": {
          "displayName": "Card",
          "hasBackSide": false,
          "orientation": "landscape",
          "aspectRatio": "card"
        },
        "expected": {
          "documentType": "generic",
          "displayName": "Card",
          "hasBackSide": false,
          "orientation": "landscape",
          "knownAspectRatio": 1.586,
          "idType": "IDENTITY_CARD",
          "matched": false,
          "captureBothSides": true,
          "triggerText": "Card · landscape · front only · chosen",
          "matchRowLabel": "Match document (Generic document)"
        }
      }
    ],
    "resets": {
      "rule": "Choosing a different document or a different country clears the override back to matchDocument: an override describes one pairing.",
      "cases": [
        {
          "name": "Choosing another document resets an override to Match",
          "captureAs": "passport",
          "document": {
            "code": "IDENTITY_CARD",
            "name": "Identity Card",
            "hasBack": true,
            "format": 1
          },
          "change": {
            "document": {
              "code": "ALIEN_CARD",
              "name": "Alien ID",
              "hasBack": false,
              "format": 1
            }
          },
          "expected": "matchDocument"
        },
        {
          "name": "Choosing a country resets an override to Match",
          "captureAs": "greenBook",
          "document": {
            "code": "IDENTITY_CARD",
            "name": "Identity Card",
            "hasBack": true,
            "format": 1
          },
          "change": {
            "country": {
              "code": "KE",
              "name": "Kenya"
            }
          },
          "expected": "matchDocument"
        },
        {
          "name": "Choosing the same document again keeps the override",
          "captureAs": "passport",
          "document": {
            "code": "IDENTITY_CARD",
            "name": "Identity Card",
            "hasBack": true,
            "format": 1
          },
          "change": {
            "document": {
              "code": "IDENTITY_CARD",
              "name": "Identity Card",
              "hasBack": true,
              "format": 1
            }
          },
          "expected": "passport"
        }
      ]
    },
    "aspectRatios": {
      "off": null,
      "card": 1.586,
      "passport": 1.309,
      "booklet": 0.748
    },
    "note": "A case without captureBothSides has the Settings switch on. `matched` is false for every override."
  }
}
