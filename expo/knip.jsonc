// Dead-code check for the Expo workspace, run by verify.sh. Each ignore is a place knip cannot see a use.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Supplied by the workspace packages the root scripts run inside.
  "ignoreBinaries": ["tsc", "jest"],
  "workspaces": {
    ".": {},
    "app": {
      // verify.sh runs expo-doctor; knip's Expo plugin assumes expo-updates, which this app does not use.
      "ignoreDependencies": ["expo-doctor", "expo-updates"]
    },
    "sample-ui": {
      // Metro resolves a platform-suffixed file in place of its base, so nothing imports it by name.
      "entry": ["src/**/*.{android,ios}.tsx"],
      // Generated by the repo's scripts, which own their export surface; verify.sh fails a hand edit.
      "ignore": ["src/tokens.ts", "src/smile-icons.ts"],
      // Named only by jest.config.js, as a module mapping and a transform.
      "ignoreDependencies": ["@expo/vector-icons"],
      "ignoreUnresolved": ["babel-jest"]
    }
  }
}
