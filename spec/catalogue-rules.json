{
  "description": "Test cases for the pure functions that turn an API response into the form's rows, asserted by all four platforms. Taken once from the 2026-09-28 sandbox responses plus a few synthetic rows for cases the data has no example of; they test the rules, so they change only when a rule does.",
  "idTypes": {
    "allowedRequiredFields": [
      "country",
      "first_name",
      "id_number",
      "id_type",
      "last_name",
      "partner_id",
      "partner_params",
      "timestamp"
    ],
    "rule": "An ID type is listed only when every entry in its required_fields is one the form can supply: the fields the SDK fills in, plus first_name and last_name from the user-details form. Rows keep API order. A row's id is its `type`; a `type` already used earlier in the same country gets _2, _3 in API order.",
    "cases": [
      {
        "name": "every required field is supplied",
        "country": "KE",
        "input": [
          {
            "country": "KE",
            "label": "National ID",
            "regex": "^[0-9]{1,9}$",
            "required_fields": [
              "country",
              "id_number",
              "id_type",
              "partner_id",
              "partner_params",
              "timestamp"
            ],
            "type": "NATIONAL_ID"
          },
          {
            "country": "KE",
            "label": "Phone Number",
            "regex": "^(\\+?254|0)?\\d{9}$",
            "required_fields": [
              "country",
              "id_number",
              "id_type",
              "partner_id",
              "partner_params",
              "timestamp"
            ],
            "type": "PHONE_NUMBER"
          }
        ],
        "expected": [
          {
            "id": "NATIONAL_ID",
            "type": "NATIONAL_ID",
            "label": "National ID"
          },
          {
            "id": "PHONE_NUMBER",
            "type": "PHONE_NUMBER",
            "label": "Phone Number"
          }
        ]
      },
      {
        "name": "dob, citizenship and session_id drop a type; first_name and last_name do not",
        "country": "NG",
        "input": [
          {
            "country": "NG",
            "label": "Bank Verification Number",
            "regex": "^[0-9]{11}$",
            "required_fields": [
              "country",
              "id_number",
              "id_type",
              "partner_id",
              "partner_params",
              "session_id",
              "timestamp"
            ],
            "type": "BVN_MFA"
          },
          {
            "country": "NG",
            "label": "National ID",
            "regex": "^[0-9]{10}$",
            "required_fields": [
              "country",
              "dob",
              "first_name",
              "id_number",
              "id_type",
              "last_name",
              "partner_id",
              "partner_params",
              "timestamp"
            ],
            "type": "NATIONAL_ID"
          },
          {
            "country": "NG",
            "label": "National ID",
            "regex": "^[0-9]{11}$",
            "required_fields": [
              "country",
              "id_number",
              "id_type",
              "partner_id",
              "partner_params",
              "timestamp"
            ],
            "type": "NIN"
          },
          {
            "country": "NG",
            "label": "Passport",
            "regex": "^[A-Za-z]{1}( )?[0-9]{8}$",
            "required_fields": [
              "country",
              "dob",
              "first_name",
              "id_number",
              "id_type",
              "last_name",
              "partner_id",
              "partner_params",
              "timestamp"
            ],
            "type": "PASSPORT"
          },
          {
            "country": "NG",
            "label": "Phone Number",
            "regex": "^(234|0)\\d{10}$",
            "required_fields": [
              "country",
              "first_name",
              "id_number",
              "id_type",
              "last_name",
              "partner_id",
              "partner_params",
              "timestamp"
            ],
            "type": "PHONE_NUMBER"
          }
        ],
        "expected": [
          {
            "id": "NIN",
            "type": "NIN",
            "label": "National ID"
          },
          {
            "id": "PHONE_NUMBER",
            "type": "PHONE_NUMBER",
            "label": "Phone Number"
          }
        ]
      },
      {
