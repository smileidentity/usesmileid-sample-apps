{
  "description": "The lists a device flow sees under the `catalogue=fixture` launch argument, in the API's own response shape so one decoder reads both. A UI test input, not a copy of the API: about a dozen rows, each here for a case the form has to handle, and it changes only when the form gains a case — never because the API did. Live runs read GET /v3/services/supported_id_types and GET /v3/services/supported_documents instead, every country in both.",
  "cases": {
    "KE IDENTITY_CARD": "a two-sided card",
    "KE PASSPORT": "a passport (format 3), one-sided",
    "KE ALIEN_CARD": "a one-sided card, which a GenericDocument must not ask a back side of",
    "ZA IDENTITY_CARD green_book": "a standalone sub-type: its own row, submitting the parent code",
    "the '' code (Others)": "left out of the list",
    "KE NATIONAL_ID": "a type with a simple regex",
    "GH GHANA_CARD": "a regex with groups and alternation",
    "GH PHONE_NUMBER": "needs a field the form cannot collect, so it is not listed",
    "NG NATIONAL_ID": "needs dob, so it is not listed",
    "ET": "a country whose only type is not listed, so ET is not offered for KYC"
  },
  "supported_id_types": {
    "id_types": [
      {
        "country": "ET",
        "label": "National ID",
        "regex": "^[A-Za-z0-9_-]{1,64}$",
        "required_fields": [
          "country",
          "id_number",
          "id_type",
          "openid_state",
          "partner_id",
          "partner_params",
          "timestamp"
        ],
        "type": "NATIONAL_ID"
      },
      {
        "country": "GH",
        "label": "GHANA CARD",
