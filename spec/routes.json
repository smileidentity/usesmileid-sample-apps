  "automationEntry": {
    "description": "Automation drives routes directly rather than tapping through. Both mechanisms must reach the same route table.",
    "deepLink": "<scheme>://<path>?scenario=…&theme=…&route=…  — e.g. usesmileid-sample-android://flow/biometricKyc/run?scenario=expiredToken&route=shell",
    "launchArgs": "see launch-args.json; the args resolve to the same route plus the same query parameters",
    "rule": "Every route in this table must be openable cold (process not running) and warm. Cold-start deep links are where argument parsing and state restoration break."
  },
  "sdkOwnedScreens": {
    "comment": "Screens with no host route BY DESIGN — the SDK renders them inside its own flow, so a route-vs-screen check will always show `consent` as unrouted and that is correct.",
    "screens": [
      "consent"
    ],
    "alsoUnrouted": [
      "instructions",
      "capture",
      "preview",
      "processing — none of these are screens.json entries either; they exist only inside the SDK"
    ]
  }
}
