  "documents": {
    "rule": "Every document in the country's supported_documents is listed in API order, except one whose code is empty (the API's 'Others'). A sub-type with display_standalone true becomes its own row right after its parent: its id is <code>_<sub-type id>, its name, has_back and format are its own, and it submits the parent's code. A sub-type without display_standalone is not listed. On enhancedDocumentVerification a green_book row is not listed, because the SDK refuses that document on that product; a case without product is documentVerification.",
    "cases": [
      {
        "name": "Others is left out, the rest keep API order",
        "country": "KE",
        "input": [
          {
            "country": {
              "code": "KE",
              "continent": "AFRICA",
              "name": "Kenya"
            },
            "id_types": [
              {
                "code": "ALIEN_CARD",
                "example": [
                  "Alien Identity Card"
                ],
                "format": 1,
                "has_back": false,
                "name": "Alien ID"
              },
              {
                "code": "DRIVERS_LICENSE",
                "example": [
                  "Driving License"
                ],
                "format": 1,
                "has_back": true,
                "name": "Driver's License"
              },
              {
                "code": "IDENTITY_CARD",
                "example": [
                  "Consular IDs",
                  "Diplomat IDs",
                  "National IDs"
                ],
                "format": 1,
                "has_back": true,
                "name": "Identity Card"
              },
              {
                "code": "PASSPORT",
                "example": [
                  "Passports"
                ],
                "format": 3,
                "has_back": false,
                "name": "Passport"
              },
              {
                "code": "RESIDENT_ID",
                "example": [
                  "Residency cards",
                  "Residency permits"
                ],
                "format": 1,
                "has_back": true,
                "name": "Resident ID"
              },
              {
                "code": "TRAVEL_DOC",
                "example": [
                  "Border crossing documents",
                  "Refugee document",
                  "Visas"
                ],
                "format": 1,
                "has_back": false,
                "name": "Travel Document"
              },
              {
                "code": "UNIFORMED_SERVICES_CARD",
                "example": [
                  "Military",
                  "Other Armed Forces Id"
                ],
                "format": 1,
                "has_back": true,
                "name": "Uniformed Services Card"
              },
              {
                "code": "",
                "example": [
                  "My document is not listed"
                ],
                "format": 1,
                "has_back": true,
                "name": "Others"
              }
            ]
          }
        ],
        "expected": [
          {
            "id": "ALIEN_CARD",
            "code": "ALIEN_CARD",
            "subType": null,
            "name": "Alien ID",
            "hasBack": false,
            "format": 1
          },
          {
            "id": "DRIVERS_LICENSE",
            "code": "DRIVERS_LICENSE",
            "subType": null,
            "name": "Driver's License",
            "hasBack": true,
            "format": 1
          },
          {
            "id": "IDENTITY_CARD",
            "code": "IDENTITY_CARD",
            "subType": null,
            "name": "Identity Card",
            "hasBack": true,
            "format": 1
          },
          {
            "id": "PASSPORT",
            "code": "PASSPORT",
            "subType": null,
            "name": "Passport",
            "hasBack": false,
            "format": 3
          },
          {
            "id": "RESIDENT_ID",
            "code": "RESIDENT_ID",
            "subType": null,
            "name": "Resident ID",
            "hasBack": true,
            "format": 1
          },
          {
            "id": "TRAVEL_DOC",
            "code": "TRAVEL_DOC",
            "subType": null,
            "name": "Travel Document",
            "hasBack": false,
            "format": 1
          },
          {
            "id": "UNIFORMED_SERVICES_CARD",
            "code": "UNIFORMED_SERVICES_CARD",
            "subType": null,
            "name": "Uniformed Services Card",
            "hasBack": true,
            "format": 1
          }
        ]
      },
