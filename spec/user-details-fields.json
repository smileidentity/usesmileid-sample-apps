{
  "description": "Which rows the user-details form shows, read from `fields_to_collect` in `GET /v3/services/config`. The form asks only for what the API says a product needs: a name the partner may leave out is not shown at all, and a field the token binds shows as provided. The configuration is read without `product`, so one response carries every product's fields; Enhanced and Biometric KYC also read that response's `products` entry, which lists each country's ID types with their own fields, and Enhanced Document Verification reads its lists from there too. All four platforms assert every case.",
  "productKeys": {
    "smartSelfieEnrollment": null,
    "smartSelfieAuth": null,
    "biometricKyc": "biometric_kyc",
    "enhancedKyc": "enhanced_kyc",
    "documentVerification": "doc_verification",
    "enhancedDocumentVerification": "enhanced_document_verification",
    "residencyDocumentVerification": "residency_document_verification"
  },
  "idTypeProducts": ["biometricKyc", "enhancedKyc"],
  "rules": {
    "names": "`given_names` and `last_name` each: a name the token binds shows as provided, whatever the list says. Otherwise the product's list decides: listed with `required: true` asks for it, and a name the list leaves out is not shown. The API leaves the names out when the partner may skip them; servers that predate that list them with `required: false`, which is not shown either. The API also leaves out whatever the token binds, which is why a binding is read first.",
    "contact": "`email` and `phone_number` share `one_of_group: contact`, and the list never hides them: one of the two is asked for unless the token binds either.",
    "fallback": "A product with no key, a key the response does not carry, or no configuration at all keeps the token rule: each name, and one contact, is asked for unless the token binds it. A configuration read for another session, or with no live session, counts as none.",
    "submission": "A row that is not shown submits nothing. The API judges what is missing and its message reaches the result card.",
    "idTypes": "For the `idTypeProducts`, the form comes before the ID type is picked, so a name the list leaves out is still asked when any ID type in `products.<key>` lists it with `required: true`. At submit, a name the picked country and ID type's entry does not list with `required: true` is not sent; with no entry for that pair, the form's rows decide. Other products read only `fields_to_collect`."
  },
  "outcomes": {
    "ask": "The row is shown and the form needs it before Continue.",
    "hidden": "The row is not shown.",
    "provided": "The token binds it, so the row shows as provided.",
    "sent": "A typed name is submitted.",
    "dropped": "A typed name is left out of the submission."
  },
  "cases": [
    {
      "name": "names the partner may leave out",
      "product": "enhancedKyc",
      "fieldsToCollect": {
        "enhanced_kyc": [
          { "label": "ID number", "name": "id_number", "required": true, "type": "text" },
          { "label": "Email address", "name": "email", "one_of_group": "contact", "required": false, "type": "email" },
          { "label": "Phone number", "name": "phone_number", "one_of_group": "contact", "regex": "^\\+[1-9]\\d{6,14}$", "required": false, "type": "phone" }
        ]
      },
      "bindings": {},
      "expect": { "firstName": "hidden", "lastName": "hidden", "contact": "ask" }
    },
    {
      "name": "names the partner may leave out, as an older server marks them",
      "product": "enhancedKyc",
      "fieldsToCollect": {
        "enhanced_kyc": [
          { "label": "Given names", "name": "given_names", "required": false, "type": "text" },
          { "label": "Last name", "name": "last_name", "required": false, "type": "text" },
          { "label": "Email address", "name": "email", "one_of_group": "contact", "required": false, "type": "email" },
          { "label": "Phone number", "name": "phone_number", "one_of_group": "contact", "required": false, "type": "phone" }
        ]
      },
      "bindings": {},
      "expect": { "firstName": "hidden", "lastName": "hidden", "contact": "ask" }
    },
    {
      "name": "a product that needs the names, beside one that does not",
      "product": "biometricKyc",
      "fieldsToCollect": {
        "enhanced_kyc": [
          { "label": "Given names", "name": "given_names", "type": "text" },
          { "label": "Last name", "name": "last_name", "type": "text" }
        ],
        "biometric_kyc": [
          { "label": "Given names", "name": "given_names", "required": true, "type": "text" },
          { "label": "Last name", "name": "last_name", "required": true, "type": "text" },
          { "label": "Email address", "name": "email", "one_of_group": "contact", "required": false, "type": "email" },
          { "label": "Phone number", "name": "phone_number", "one_of_group": "contact", "required": false, "type": "phone" }
        ]
      },
      "bindings": {},
      "expect": { "firstName": "ask", "lastName": "ask", "contact": "ask" }
    },
    {
      "name": "the token binds the names",
      "product": "documentVerification",
      "fieldsToCollect": {
        "doc_verification": [
          { "label": "Email address", "name": "email", "one_of_group": "contact", "required": false, "type": "email" },
          { "label": "Phone number", "name": "phone_number", "one_of_group": "contact", "required": false, "type": "phone" }
        ]
      },
      "bindings": { "givenNames": true, "lastName": true },
      "expect": { "firstName": "provided", "lastName": "provided", "contact": "ask" }
    },
    {
      "name": "the token binds a contact",
      "product": "enhancedDocumentVerification",
      "fieldsToCollect": {
        "enhanced_document_verification": [
          { "label": "Given names", "name": "given_names", "required": true, "type": "text" },
          { "label": "Last name", "name": "last_name", "required": true, "type": "text" }
        ]
      },
      "bindings": { "email": true },
      "expect": { "firstName": "ask", "lastName": "ask", "contact": "provided" }
    },
    {
      "name": "one name the partner may leave out, the other the token binds",
      "product": "residencyDocumentVerification",
      "fieldsToCollect": {
        "residency_document_verification": [
          { "label": "Given names", "name": "given_names", "type": "text" },
          { "label": "Email address", "name": "email", "one_of_group": "contact", "required": false, "type": "email" },
          { "label": "Phone number", "name": "phone_number", "one_of_group": "contact", "required": false, "type": "phone" }
        ]
      },
      "bindings": { "lastName": true },
      "expect": { "firstName": "hidden", "lastName": "provided", "contact": "ask" }
    },
    {
      "name": "a product with no key keeps the token rule",
      "product": "smartSelfieEnrollment",
      "fieldsToCollect": {
        "enhanced_kyc": [
          { "label": "Given names", "name": "given_names", "type": "text" },
          { "label": "Last name", "name": "last_name", "type": "text" }
        ]
      },
      "bindings": { "givenNames": true },
      "expect": { "firstName": "provided", "lastName": "ask", "contact": "ask" }
    },
    {
      "name": "a key the response does not carry keeps the token rule",
      "product": "enhancedKyc",
      "fieldsToCollect": {},
      "bindings": { "phoneNumber": true },
      "expect": { "firstName": "ask", "lastName": "ask", "contact": "provided" }
    },
    {
      "name": "an empty list with nothing bound hides the names but still asks for a contact",
      "product": "documentVerification",
      "fieldsToCollect": { "doc_verification": [] },
      "bindings": {},
      "expect": { "firstName": "hidden", "lastName": "hidden", "contact": "ask" }
    },
    {
      "name": "a required name the token binds shows as provided",
      "product": "biometricKyc",
      "fieldsToCollect": {
        "biometric_kyc": [
          { "label": "Given names", "name": "given_names", "required": true, "type": "text" },
          { "label": "Last name", "name": "last_name", "required": true, "type": "text" }
        ]
      },
      "bindings": { "givenNames": true },
      "expect": { "firstName": "provided", "lastName": "ask", "contact": "ask" }
    },
    {
      "name": "a name the partner may leave out that the token binds shows as provided",
      "product": "enhancedKyc",
      "fieldsToCollect": {
        "enhanced_kyc": [
          { "label": "Given names", "name": "given_names", "type": "text" },
          { "label": "Last name", "name": "last_name", "type": "text" }
        ]
      },
      "bindings": { "lastName": true, "email": true },
      "expect": { "firstName": "hidden", "lastName": "provided", "contact": "provided" }
    },
    {
      "name": "no configuration keeps the token rule",
      "product": "biometricKyc",
      "fieldsToCollect": null,
      "bindings": {},
      "expect": { "firstName": "ask", "lastName": "ask", "contact": "ask" }
    },
    {
