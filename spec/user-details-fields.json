            { "key_name": "ALIEN_CARD", "label": "Alien Card", "fields": [
              { "label": "ID number", "key_name": "id_number", "required": true, "field_type": "text" },
              { "label": "Email address", "key_name": "email", "one_of_group": "contact", "required": false, "field_type": "email" }
            ] },
            { "key_name": "NATIONAL_ID", "label": "National ID", "fields": [
