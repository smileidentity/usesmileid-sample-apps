{
  "description": "How the user-details form and the new-profile sheet submit an email or a phone number. Neither form checks either value: the API judges what it receives and its message reaches the result card, so no value holds a form back here. Formatting is not a check: a phone number loses its separators, because the placeholder shows one with spaces and the API's E.164 pattern takes none. Each platform asserts that every case submits as `submits`, and that none keeps a form from continuing.",
  "email": { "trim": true },
  "phone": { "trim": true, "strip": "[\\s().-]" },
  "submission": "The trimmed email, and the phone number with `strip` removed. A blank value submits nothing.",
  "cases": [
    { "field": "email", "value": "", "submits": "" },
    { "field": "email", "value": "ada@example.com", "submits": "ada@example.com" },
    { "field": "email", "value": "  ada.okafor@uptech.co.ke ", "submits": "ada.okafor@uptech.co.ke" },
    { "field": "email", "value": "ada", "submits": "ada" },
    { "field": "email", "value": "ada@example", "submits": "ada@example" },
    { "field": "email", "value": "ada@example.c", "submits": "ada@example.c" },
    { "field": "email", "value": "ada okafor@example.com", "submits": "ada okafor@example.com" },
    { "field": "email", "value": "ada@@example.com", "submits": "ada@@example.com" },
    { "field": "phone", "value": "", "submits": "" },
    { "field": "phone", "value": "+254700000000", "submits": "+254700000000" },
    { "field": "phone", "value": "+254 700 000 000", "submits": "+254700000000" },
    { "field": "phone", "value": "+1 (415) 555-0100", "submits": "+14155550100" },
    { "field": "phone", "value": "0700000000", "submits": "0700000000" },
    { "field": "phone", "value": "+0254700000", "submits": "+0254700000" },
    { "field": "phone", "value": "+25470", "submits": "+25470" },
    { "field": "phone", "value": "+2547000000000000", "submits": "+2547000000000000" },
    { "field": "phone", "value": "+254 7OO 000 000", "submits": "+2547OO000000" }
  ]
