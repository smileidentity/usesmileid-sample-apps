{
  "version": 1,
  "description": "The shared route table. Route ids and deep-link paths are identical on all four platforms; only the platform binding differs. Every route must be reachable by deep link, because automation cannot rely on tapping its way to a screen — see launch-args.json.",
  "rules": [
    "Route ids match screen ids in screens.json. A screen with no route is a component, not a screen.",
    "Deep-link paths are identical across platforms. The scheme is per app (see app-identity.json) — usesmileid-sample-android://products, usesmileid-sample-ios://products, and so on.",
    "Sheets are ROUTES, not local booleans, so a deep link can open one and a flow can assert it.",
    "The SDK flow is ONE route with TWO presentations. Same destination, different container.",
    "Arguments are typed on every platform. A stringly-typed argument that only fails at runtime is a defect.",
    "Dev-only shell surfaces are NOT routes in this table, deliberately. A component gallery or API scratchpad belongs to one shell, is not part of the journey the four apps share, and must not oblige the other three to build a counterpart. They still get a deep link under their app's own scheme, because reaching one cold is the only way a flow can drive it, and their ids use a dev_ prefix so the sample_ namespace stays the spec's. Android has one today: usesmileid-sample-android://debug/components."
  ],
  "routes": [
    {
      "id": "products",
      "screen": "products",
      "path": "/products",
      "presentation": "tab",
      "args": [],
      "platform": {
        "android": "ProductsScreenDestination",
        "ios": "Route.products",
        "flutter": "/products",
        "expo": "app/(tabs)/products.tsx"
      }
    },
    {
      "id": "verifications",
      "screen": "verifications",
      "path": "/verifications",
      "presentation": "tab",
      "args": [],
      "platform": {
        "android": "VerificationsScreenDestination",
        "ios": "Route.verifications",
        "flutter": "/verifications",
        "expo": "app/(tabs)/verifications.tsx"
      }
    },
    {
      "id": "settings",
      "screen": "settings",
      "path": "/settings",
      "presentation": "tab",
      "args": [],
      "platform": {
        "android": "SettingsScreenDestination",
        "ios": "Route.settings",
        "flutter": "/settings",
        "expo": "app/(tabs)/settings.tsx"
      }
    },
    {
      "id": "verificationDetails",
      "screen": "verificationDetails",
      "path": "/verifications/:jobId",
      "presentation": "push",
      "args": [
        {
          "name": "jobId",
          "type": "string",
          "required": true
        }
      ],
      "platform": {
        "android": "VerificationDetailsScreenDestination",
        "ios": "Route.verificationDetails(jobId:)",
        "flutter": "/verifications/:jobId",
        "expo": "app/(tabs)/verifications/[jobId].tsx"
      },
      "notes": "Also the post-submission landing route — see navigation-plan.md rule R4 (replace, don't stack)."
    },
    {
      "id": "consentDetailsForm",
      "screen": "userDetails",
      "path": "/flow/:productId/details",
      "presentation": "push",
      "args": [
        {
          "name": "productId",
          "type": "string",
          "required": true
        }
      ],
      "platform": {
        "android": "ConsentDetailsFormScreenDestination",
        "ios": "Route.consentDetailsForm(productId:)",
        "flutter": "/flow/:productId/details",
        "expo": "app/flow/[productId]/details.tsx"
      },
      "notes": "The owner's 'Consent Details Form'. Shown for every product, seeded from the active profile."
    },
    {
      "id": "idDetailsForm",
      "screen": "kycIdForm",
      "path": "/flow/:productId/id-details",
      "presentation": "push",
      "args": [
        {
          "name": "productId",
          "type": "string",
          "required": true
        }
      ],
      "platform": {
        "android": "IdDetailsFormScreenDestination",
        "ios": "Route.idDetailsForm(productId:)",
        "flutter": "/flow/:productId/id-details",
        "expo": "app/flow/[productId]/id-details.tsx"
      },
      "notes": "Only for products whose spec entry sets needsIdDetails."
    },
    {
      "id": "sdkFlow",
      "screen": null,
      "path": "/flow/:productId/run",
      "presentation": "push | fullScreen",
      "args": [
        {
          "name": "productId",
          "type": "string",
          "required": true
        },
        {
          "name": "route",
          "type": "enum(fullscreen,shell)",
          "required": false,
          "default": "fullscreen"
        }
      ],
      "platform": {
        "android": "SdkFlowScreenDestination",
        "ios": "Route.sdkFlow(productId:presentation:)",
        "flutter": "/flow/:productId/run",
        "expo": "app/flow/[productId]/run.tsx"
      },
      "notes": "ONE route, TWO presentations. The SDK owns everything inside it — the host must not model consent/instructions/capture/preview/processing as routes of its own."
    },
    {
      "id": "countryPicker",
      "screen": "countryPickerSheet",
      "path": "/flow/:productId/id-details/country",
      "presentation": "fullSheet",
      "args": [
        {
          "name": "productId",
          "type": "string",
          "required": true
        }
      ],
      "platform": {
        "android": "CountryPickerSheetDestination",
        "ios": "Sheet.countryPicker",
        "flutter": "/flow/:productId/id-details/country",
        "expo": "app/flow/[productId]/id-details/country.tsx"
      }
    },
    {
      "id": "idTypePicker",
      "screen": "idTypePickerSheet",
      "path": "/flow/:productId/id-details/id-type",
      "presentation": "fullSheet",
      "args": [
        {
          "name": "productId",
          "type": "string",
          "required": true
        }
      ],
      "platform": {
        "android": "IdTypePickerSheetDestination",
        "ios": "Sheet.idTypePicker",
        "flutter": "/flow/:productId/id-details/id-type",
        "expo": "app/flow/[productId]/id-details/id-type.tsx"
      },
      "notes": "Unreachable until a country is selected — the trigger is disabled, so the route must also reject entry without one."
    },
    {
      "id": "profileSwitch",
      "screen": "profileSwitchSheet",
      "path": "/profiles/switch",
      "presentation": "modalSheet",
      "args": [],
      "platform": {
        "android": "ProfileSwitchSheetDestination",
        "ios": "Sheet.profileSwitch",
        "flutter": "/profiles/switch",
        "expo": "app/profiles/switch.tsx"
      }
    },
    {
      "id": "profiles",
      "screen": "profiles",
      "path": "/profiles",
      "presentation": "push",
      "args": [],
      "platform": {
        "android": "ProfilesScreenDestination",
        "ios": "Route.profiles",
        "flutter": "/profiles",
        "expo": "app/profiles/index.tsx"
      }
    },
    {
      "id": "profileConfig",
      "screen": "profileConfig",
      "path": "/profiles/:profileId",
      "presentation": "push",
      "args": [
        {
          "name": "profileId",
          "type": "string",
          "required": true
        }
      ],
      "platform": {
        "android": "ProfileConfigScreenDestination",
        "ios": "Route.profileConfig(profileId:)",
        "flutter": "/profiles/:profileId",
        "expo": "app/profiles/[profileId].tsx"
      }
    },
    {
      "id": "newProfile",
      "screen": "newProfileSheet",
      "path": "/profiles/new",
      "presentation": "modalSheet",
      "args": [],
      "platform": {
        "android": "NewProfileSheetDestination",
        "ios": "Sheet.newProfile",
        "flutter": "/profiles/new",
        "expo": "app/profiles/new.tsx"
      },
      "notes": "Declared before /profiles/:profileId so 'new' is not swallowed as a profile id."
    },
    {
      "id": "scanToken",
      "screen": "scanToken",
      "path": "/token/scan",
      "presentation": "push",
      "args": [],
      "platform": {
        "android": "ScanTokenScreenDestination",
        "ios": "Route.scanToken",
        "flutter": "/token/scan",
        "expo": "app/token/scan.tsx"
      }
    },
    {
      "id": "scenarioDrawer",
      "screen": "scenarioDrawer",
      "path": "/debug/scenarios",
      "presentation": "modalSheet",
      "args": [],
      "platform": {
        "android": "ScenarioDrawerSheetDestination",
        "ios": "Sheet.scenarioDrawer",
        "flutter": "/debug/scenarios",
        "expo": "app/debug/scenarios.tsx"
      },
      "notes": "A debug affordance with no design frame. Deep-linkable so a flow can open it directly rather than reproducing a hidden gesture."
    }
  ],
  "automationEntry": {
    "description": "Automation drives routes directly rather than tapping through. Both mechanisms must reach the same route table.",
    "deepLink": "<scheme>://<path>?scenario=…&theme=…&route=…  — e.g. usesmileid-sample-android://flow/biometricKyc/run?scenario=expiredToken&route=shell",
    "launchArgs": "see launch-args.json; the args resolve to the same route plus the same query parameters",
    "rule": "Every route in this table must be openable cold (process not running) and warm. Cold-start deep links are where argument parsing and state restoration break."
  },
  "sdkOwnedScreens": {
    "comment": "Screens with no host route BY DESIGN — the SDK renders them inside its own flow, so a route-vs-screen check will always show `consent` as unrouted and that is correct.",
    "screens": [
      "consent"
    ],
    "alsoUnrouted": [
      "instructions",
      "capture",
      "preview",
      "processing — none of these are screens.json entries either; they exist only inside the SDK"
    ]
  }
}
