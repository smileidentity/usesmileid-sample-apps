# --- secrets: never commit (see AGENTS.md → Security & Credentials) ---
*.jks
*.keystore
*.p12
*.mobileprovision
.env
.env.*
secrets.*
!secrets.example.*
local.properties

# --- Android / Gradle ---
.gradle/
build/
captures/
.cxx/
*.iml

# --- iOS / Xcode ---
# Generated by XcodeGen from ios/App/project.yml, which is the reviewable source of truth.
ios/App/*.xcodeproj
ios/App/Info.plist
xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
.swiftpm/
Pods/
*.xcarchive

# --- Flutter / Dart ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
*.lock.bak
pubspec_overrides.yaml

# --- Node / Expo / React Native ---
node_modules/
.expo/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# --- Python ---
# scripts/ is run with python3, which writes bytecode next to the sources. One .pyc was committed
# by accident twice before this line existed; nothing here is reproducible from a checkout.
__pycache__/
*.py[cod]

# --- editors / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db
.build/

# Kotlin compiler session files: build output, and a tracked one shows as a phantom deletion after every build.
android/.kotlin/
