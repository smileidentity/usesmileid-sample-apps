              { "label": "Last name", "key_name": "last_name", "required": true, "field_type": "text" },
              { "label": "Email address", "key_name": "email", "one_of_group": "contact", "required": false, "field_type": "email" }
            ] }
          ]
        }
      },
      "bindings": {},
      "expect": { "firstName": "ask", "lastName": "ask", "contact": "ask" },
      "submit": [
        { "country": "KE", "idType": "ALIEN_CARD", "firstName": "dropped", "lastName": "dropped" },
        { "country": "KE", "idType": "NATIONAL_ID", "firstName": "sent", "lastName": "sent" },
        { "country": "KE", "idType": "PASSPORT", "firstName": "sent", "lastName": "sent" },
        { "country": "NG", "idType": "NATIONAL_ID", "firstName": "sent", "lastName": "sent" }
      ]
    },
    {
