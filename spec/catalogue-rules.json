  "countries": {
    "rule": "The KYC products offer every country with at least one listed ID type; the document products every country with at least one listed document. Names come from supported_documents, which carries them; a KYC country it does not name is shown by its code. Countries keep supported_documents' order (alphabetical by English name), and a KYC-only country follows them in its supported_id_types order.",
    "cases": [
      {
        "name": "the fixture, KYC family",
        "family": "kyc",
