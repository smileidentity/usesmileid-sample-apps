# --- secrets: never commit (see AGENTS.md → Security & Credentials) ---
*.jks
*.keystore
*.p12
# A keystore base64'd for a CI secret is still the keystore.
*.b64
*.mobileprovision
.env
.env.*
secrets.*
!secrets.example.*
local.properties

# --- Android / Gradle ---
.gradle/
build/
captures/
.cxx/
*.iml

# --- iOS / Xcode ---
# Generated by XcodeGen from ios/App/project.yml, which is the reviewable source of truth.
ios/App/*.xcodeproj
ios/App/Info.plist
xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
.swiftpm/
Pods/
*.xcarchive

# --- Flutter / Dart ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
*.lock.bak
pubspec_overrides.yaml

# --- Node / Expo / React Native ---
node_modules/
.expo/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# --- editors / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db
