<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UseSmileIDSample">

        <!--
          Orientation is deliberately NOT locked and configChanges is deliberately NOT declared:
          rotation has to recreate the activity, because surviving recreation is a requirement of
          the navigation contract, not something to design around.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              One filter for the whole scheme; the route table in spec/routes.json decides which
              destination a given URI reaches. The scheme is per app (spec/app-identity.json) —
              two apps claiming one scheme raise a disambiguation prompt that breaks automation.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="usesmileid-sample-android" />
            </intent-filter>
        </activity>
    </application>

</manifest>
