                android:fillColor="#000000"
                android:pathData="M 369.7 67.6 c -1.1 0 -2.1 0.1 -3.2 0.1 c -1.1 0 -2.1 -0.1 -3.2 -0.1 c -59.2 0 -112.1 38.6 -112.1 123.7 v 88.2 h 231.5 v -88.2 C 482.9 106.2 429.3 67.6 369.7 67.6 z" />
